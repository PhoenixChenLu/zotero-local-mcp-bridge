{
  "name": "zotero-local-mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Zotero management MCP bridge for local MCP clients.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/PhoenixChenLu/zotero-local-mcp-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhoenixChenLu/zotero-local-mcp-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/PhoenixChenLu/zotero-local-mcp-bridge/issues"
  },
  "keywords": [
    "zotero",
    "mcp",
    "model-context-protocol",
    "research",
    "reference-manager",
    "local-first"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:stdio-adapter": "tsc -p packages/stdio-adapter/tsconfig.json",
    "build:zotero-plugin": "node scripts/buildZoteroPlugin.mjs --mode=release",
    "build:zotero-plugin:release": "node scripts/buildZoteroPlugin.mjs --mode=release",
    "install:local": "node scripts/install.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ensure:test-profile-marker": "node scripts/ensureTestProfileMarker.mjs",
    "test:mcp-runtime-matrix": "node scripts/mcpRuntimeModeMatrix.mjs",
    "pretest": "npm run ensure:test-profile-marker",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^22.15.34",
    "eslint": "^9.29.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
